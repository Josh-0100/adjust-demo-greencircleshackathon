# Synthetic, local-only demo defaults. Copy to .env if you need overrides.
DEMO_MODE=true
BACKEND_PORT=8765
FRONTEND_PORT=3000
BACKEND_URL=http://127.0.0.1:8765
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
# Defaults resolve to the project's data/civicforge.db and config YAML.
# DATABASE_URL=sqlite:////absolute/path/to/civicforge-ai/data/civicforge.db
# For PostgreSQL (not validated in this local delivery):
# DATABASE_URL=postgresql+psycopg://user:password@localhost:5432/civicforge
# CHALLENGE_CONFIG_PATH=/absolute/path/to/challenge_config.yaml

# Never use public demo role headers with real data. Non-demo mode requires
# distinct server-side tokens of >=24 characters. Frontend deployment then
# needs an authenticated session layer (see docs/responsible-ai.md).
STAFF_API_TOKEN=
ADMIN_API_TOKEN=

# Offline is the default. An optional OpenAI-compatible JSON adapter runs on
# the server and falls back safely. No secret is exposed to frontend bundles.
LLM_PROVIDER=deterministic
LLM_BASE_URL=
LLM_MODEL=
LLM_API_KEY=
LLM_TIMEOUT_SECONDS=8
REQUEST_LIMIT_PER_MINUTE=120
REQUEST_MAX_BODY_BYTES=50000

# Unified integration: full module APIs run inside the host API process.
# Adjust's independent Next.js interface runs on a separate loopback port.
ADJUST_EMBED_PORT=3002
ADJUST_FRONTEND_URL=http://127.0.0.1:3002
# Standalone module launchers keep their original ports/settings.
# BOLTON_DATABASE_PATH=/absolute/path/to/bolton_connect.db
# Integrated Bolton always inherits DEMO_MODE / STAFF_API_TOKEN / ADMIN_API_TOKEN.
# Optional ADJUST_* and BOLTON_LLM_* provider keys remain server-only.
