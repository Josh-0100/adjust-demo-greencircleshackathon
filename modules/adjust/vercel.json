{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "services": {
    "web": {
      "root": "frontend",
      "framework": "nextjs"
    },
    "api": {
      "root": ".",
      "framework": "fastapi",
      "entrypoint": "api.index:app",
      "functions": {
        "api/index.py": {
          "includeFiles": "{backend/adjust_api/**,knowledge/catalogue.json}",
          "excludeFiles": "{frontend/**,backend/tests/**,scripts/**,docs/**,*.md}",
          "maxDuration": 30
        }
      }
    }
  },
  "rewrites": [
    { "source": "/api/adjust/(.*)", "destination": { "service": "api" } },
    { "source": "/(.*)", "destination": { "service": "web" } }
  ]
}
