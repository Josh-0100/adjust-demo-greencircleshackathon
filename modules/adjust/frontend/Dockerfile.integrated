FROM node:22-alpine AS builder
WORKDIR /app
COPY modules/adjust/frontend/package.json modules/adjust/frontend/package-lock.json ./
RUN npm ci
COPY modules/adjust/frontend ./
ENV ADJUST_BASE_PATH=/modules/adjust ADJUST_EMBEDDED=1 ADJUST_BACKEND_URL=http://backend:8000 NEXT_TELEMETRY_DISABLED=1
RUN npm run build

FROM node:22-alpine
WORKDIR /app
ENV NODE_ENV=production NEXT_TELEMETRY_DISABLED=1 ADJUST_BASE_PATH=/modules/adjust ADJUST_EMBEDDED=1 ADJUST_BACKEND_URL=http://backend:8000
COPY --from=builder --chown=node:node /app ./
USER node
EXPOSE 3002
CMD ["node", "node_modules/next/dist/bin/next", "start", "--hostname", "0.0.0.0", "--port", "3002"]
